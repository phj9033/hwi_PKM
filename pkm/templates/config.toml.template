# .pkm/config.toml — committed, public defaults.
# DO NOT put `exec`, `env`, credentials, or absolute paths here.
# Use .pkm/config.local.toml for those (gitignored).

[ai_cli]
# Name of the AI CLI command alias to use by default. Definitions live in
# .pkm/config.local.toml. Empty = autodetect from PATH (claude/codex/gemini).
default = ""
fallback_order = []

[indexing]
embed_captures = false
embed_chunks   = false
batch_size     = 16

[memory]
auto_throttle   = true
low_memory_mode = false

[lint.missing_link]
# Surface wiki pairs that look semantically close but aren't directly linked.
# Reads docs_vec + links from .pkm/index.db. Silently skipped if the index
# is absent. Both `pkm lint` and the dashboard use these settings.
enabled            = true
sim_threshold      = 0.78  # cosine similarity floor (0..1, higher = stricter)
min_graph_distance = 2     # 2 = exclude directly-linked pairs only
top_k_per_doc      = 3     # cap suggestions per source doc

[dashboard.graph]
# Graph page on dashboard/graph.html. Reads links + docs_vec from .pkm/index.db.
max_nodes              = 1000   # Cap on rendered nodes (lowest-connectivity dropped first).
include_writing        = false  # Add writing nodes (off by default).
include_captures       = false  # Add capture nodes (off by default).
overlay_suggestions    = true   # Render MISSING_LINK_CANDIDATE pairs as suggested edges.

[lint.writing_grounding]
# Karpathy citation contract on writing → wiki promote (M11).
# Four rules — R1 CITATION_NOT_DERIVED / R2 DERIVED_NOT_CITED /
# R3 UNGROUNDED_WRITING / R4 BROKEN_CITATION — fire as both lint warnings
# and `pkm promote` hard gates. `purpose=essay` or frontmatter
# `grounding_exempt: true` skips R3 only; R1/R2/R4 always enforced.
enabled            = true
min_grounded_chars = 400
exempt_purposes    = ["essay"]
